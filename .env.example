# NextAuth / GitHub OAuth（LLM 演算登录）
AUTH_SECRET=请使用 openssl rand -base64 32 生成
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# 本地开发可写 http://localhost:3000
AUTH_URL=http://localhost:3000

# OpenAI 兼容接口（GitHub Models 已于 2026-07-30 退役）
# 推荐：Azure AI Foundry / OpenAI / DeepSeek 等
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1200

# 防滥用配额
DAILY_LLM_LIMIT=5
IP_CHART_LIMIT_PER_HOUR=60
IP_LLM_LIMIT_PER_HOUR=10

# 开发调试：允许 curl 等脚本客户端（生产勿开）
# ALLOW_SCRIPT_CLIENTS=1

# 配额文件：默认 .data/quota.json，生产应放在持久化可写磁盘
# 多进程必须使用同一绝对路径；独立无服务器实例不能靠本地文件共享配额
# QUOTA_STORE_PATH=/var/lib/bazi-mingli/quota.json

# 仅当反向代理会清除用户提交的同名请求头并重新写入真实 IP 时开启
# 未开启时所有请求共用 unknown IP 配额桶
TRUST_PROXY_HEADERS=0
